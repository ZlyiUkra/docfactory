#!/usr/bin/env bash
# df — запускач кроків фабрики. Один крок для одного примірника.
#
#   ./df <примірник> sources [--why]     перелік джерел і білий список ($0)
#   ./df <примірник> list                що завантажилося б, без запису ($ мережа)
#   ./df <примірник> check [--deep] [id...]      чи змінилося щось нагорі за джерелом ($ мережа)
#   ./df <примірник> refresh [--missing] [id...] завантажити корпус, лише задекларованим ($ мережа)
#   ./df <примірник> build [id...]       зібрати корпус зі сховища сирого, без мережі ($0)
#   ./df <примірник> manifest             оновити паспорт corpus/index.json ($0)
#   ./df <примірник> setup               спитати раз: Qdrant чи пошук по словах ($0)
#   ./df <примірник> vectors [--refill]  залити corpus у Qdrant (Docker, локально)
#   ./df <примірник> serve               HTTP-сервер MCP на порту примірника ($0)
#   ./df <примірник> status              стан бази й розклад оновлення ($0)
#   ./df <примірник> smoke               перевірки сервера ($0)
#   ./df <примірник> protocol            діалог по протоколу, чужим клієнтом ($0)
#   ./df <примірник> quality             замір: що дає пошук за змістом ($0)
#   ./df <примірник> raw                 сирі кадри JSON-RPC, без бібліотеки ($0)
#   ./df <примірник> tools               MCP-рукостискання, перелік інструментів ($0)
#   ./df <примірник> ask "питання"       повний прогін агента (платно)
#
# Усі кроки біжать із теки docfactory/, щоб пакети `engine`, `server`, `common`
# були видимі, і venv-ом, тож залежності завжди ті, що треба. Який саме venv:
#   1. DF_USE_SHARED=1 — спільний, .venvs/cpu або .venvs/gpu (його обирає DF_VENV);
#   2. інакше власний .venv примірника, якщо він є — примірники переходять поступово;
#   3. інакше спільний, за DF_VENV із оточення або кореневого .env, за замовчуванням cpu.
# Який саме примірник — каже змінна DF_INSTANCE_DIR (тека instances/<домен>/),
# яку df виставляє нижче: спільний код читає дані домену звідти, а не з-під себе.

set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
INST="${1:-}"; [ -n "$INST" ] || { echo "Вкажіть примірник, напр.: ./df ecmascript sources"; exit 2; }
shift
# Ім'я примірника — одне ім'я теки в instances/, а не шлях. Інакше «../щось»
# виводить запуск за межі фабрики й виконує чужий .venv/bin/python.
case "$INST" in
  */*|*\\*|.|..) echo "Ім'я примірника мусить бути одним ім'ям теки в instances/, без шляхів: «$INST»"; exit 2 ;;
esac
STEP="${1:-}"; [ -n "$STEP" ] || { echo "Вкажіть крок для «$INST», напр.: ./df $INST sources"; exit 2; }
shift

DIR="$HERE/instances/$INST"
OWN_PY="$DIR/.venv/bin/python"
[ -d "$DIR" ] || { echo "Немає примірника «$INST»: $DIR"; exit 1; }

# Спільне середовище лише називаємо тут, а в оболонку з .env нічого не виконуємо:
# DF_VENV дістається з кореневого .env рядком grep, файл не source-иться. Змінна
# оточення сильніша за файл; без обох — cpu. Назву перевіряємо лише тоді, коли
# спільне середовище справді береться, щоб криве значення не ламало примірників
# зі своїм .venv.
shared_python() {
  local name="${DF_VENV:-}"
  if [ -z "$name" ] && [ -f "$HERE/.env" ]; then
    name="$(grep -E '^[[:space:]]*DF_VENV[[:space:]]*=' "$HERE/.env" | tail -n 1 | cut -d= -f2- | tr -d "\"' \r" || true)"
  fi
  name="${name:-cpu}"
  case "$name" in
    cpu|gpu) ;;
    *) echo "DF_VENV мусить бути cpu або gpu, а не «$name»" >&2; exit 2 ;;
  esac
  SHARED_NAME="$name"
  PY="$HERE/.venvs/$name/bin/python"
}

if [ "${DF_USE_SHARED:-}" = "1" ] || [ ! -x "$OWN_PY" ]; then
  shared_python
  if [ ! -x "$PY" ]; then
    if [ "${DF_USE_SHARED:-}" = "1" ]; then
      echo "Немає спільного venv «$SHARED_NAME»: $PY"
      echo "Підніміть його за requirements/$SHARED_NAME.txt (README, розділ «Спільне середовище»)."
    else
      echo "Немає venv примірника: $OWN_PY, і немає спільного «$SHARED_NAME»: $PY"
      echo "Підніміть один із двох: власний за README примірника або спільний за requirements/$SHARED_NAME.txt."
    fi
    exit 1
  fi
else
  PY="$OWN_PY"
fi

# Тека даних цього примірника — для спільного коду, що більше не лежить усередині
# домену (common/instance.py читає саме цю змінну).
export DF_INSTANCE_DIR="$DIR"

# Конфіг примірника (config.json) сюди не читається: його відкриває сам
# Python-код там, де значення потрібне (common/instance.py). Це дані, і в
# оболонку вони не потрапляють. Раніше тут стояв eval над згенерованими
# рядками export — і поле config.json могло виконатися як команда.

# Усі кроки — з теки docfactory/: пакети engine/server/common видимі, дані домену
# код бере з DF_INSTANCE_DIR. Крок check — це engine --status.
cd "$HERE"
case "$STEP" in
  sources)  exec "$PY" -m engine --instance "$INST" --sources "$@" ;;
  list)     exec "$PY" -m engine --instance "$INST" --list "$@" ;;
  check)    exec "$PY" -m engine --instance "$INST" --status "$@" ;;
  manifest) exec "$PY" -m engine --instance "$INST" --manifest ;;
  refresh)  exec "$PY" -m engine --instance "$INST" --refresh "$@" ;;
  build)    exec "$PY" -m engine --instance "$INST" --build "$@" ;;
  setup)    exec "$PY" -m server.setup "$@" ;;
  vectors)  exec "$PY" -m server.setup --vectors "$@" ;;
  serve)
    # Перший запуск у живому терміналі, поки рішення ще не записане, — спитати:
    # файл рішення пише лише server.setup, а без файла сервер мовчки шукає по
    # словах. Відповідь q нічого не пише, і сервер чесно стартує по словах.
    if [ ! -f "$DIR/out/mode.json" ] && [ -t 0 ]; then
      "$PY" -m server.setup || true
    fi
    exec "$PY" server/spec_mcp.py --serve ;;
  status)   exec "$PY" -m server.setup --status "$@" ;;
  smoke)    exec "$PY" -m server.smoke "$@" ;;
  protocol) exec "$PY" -m server.check "$@" ;;
  quality)  exec "$PY" -m server.quality "$@" ;;
  raw)      exec "$PY" -m server.raw "$@" ;;
  tools)    exec "$PY" -m server.agent --tools ;;
  ask)      exec "$PY" -m server.agent "$@" ;;
  *) echo "Невідомий крок «$STEP». Є: sources list check manifest refresh build setup vectors serve status smoke protocol quality raw tools ask"; exit 2 ;;
esac
