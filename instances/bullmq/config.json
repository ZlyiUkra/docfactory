{
  "instance": "bullmq",
  "port": 8848,
  "collection": "docs-bullmq",
  "embed_model": "bge-small",
  "pause_sec": 0,
  "server_name": "bullmq-docs",
  "doc_set": "bullmq",
  "sections": "markdown",
  "versions": true,
  "max_per_doc": 0,
  "revision_suffix": true,
  "passage_context": true,
  "tools": {
    "search": "search_docs",
    "read": "read_section"
  },
  "answer_hosts": [
    "github.com",
    "registry.npmjs.org"
  ],
  "example_label": "Worker",
  "slug_rewrite": [
    [
      "^bullmq-docs-gitbook-",
      "bullmq-docs-"
    ],
    [
      "^bull-board-website-docs-",
      "bull-board-docs-"
    ],
    [
      "^src-src-",
      "src-"
    ],
    [
      "^test-tests-",
      "tests-"
    ],
    [
      "^python-python-",
      "python-"
    ],
    [
      "^elixir-elixir-",
      "elixir-"
    ],
    [
      "^rust-rust-",
      "rust-"
    ],
    [
      "^php-php-",
      "php-"
    ],
    [
      "^dotnet-dotnet-",
      "dotnet-"
    ],
    [
      "^bull-test-test-",
      "bull-tests-"
    ],
    [
      "^arena-src-src-",
      "arena-src-"
    ],
    [
      "^bull-board-examples-examples-",
      "bull-board-examples-"
    ]
  ]
}