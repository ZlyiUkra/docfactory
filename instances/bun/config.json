{
  "instance": "bun",
  "port": 8939,
  "collection": "docs-bun",
  "embed_model": "bge-small",
  "pause_sec": 0.2,
  "server_name": "bun-docs",
  "doc_set": "bun",
  "sections": "markdown",
  "versions": true,
  "revision_suffix": true,
  "passage_context": true,
  "tools": {
    "search": "search_docs",
    "read": "read_section"
  },
  "answer_hosts": [
    "bun.com",
    "bun.sh",
    "github.com",
    "www.npmjs.com",
    "hub.docker.com"
  ],
  "example_label": "serve",
  "demote": {
    "pattern": "^(?:docs-docs-(?:api|cli|install|ecosystem|dev)|blog|bun-release)-",
    "places": 10
  }
}
