{
  "instance": "certbot",
  "port": 8811,
  "collection": "docs-certbot",
  "embed_model": "bge-small",
  "pause_sec": 0.3,
  "server_name": "certbot-docs",
  "doc_set": "certbot",
  "sections": "markdown",
  "versions": true,
  "max_per_doc": 0,
  "revision_suffix": true,
  "passage_context": true,
  "tools": {
    "search": "search_docs",
    "read": "read_section"
  },
  "answer_hosts": [
    "eff-certbot.readthedocs.io",
    "certbot.eff.org",
    "github.com",
    "pypi.org"
  ],
  "example_label": "certbot",
  "slug_rewrite": [
    [
      "^docs-",
      "certbot-docs-"
    ],
    [
      "^(certbot-dns-[a-z0-9]+)-(?:src-)?certbot-dns-[a-z0-9]+-init$",
      "\\1"
    ]
  ]
}
