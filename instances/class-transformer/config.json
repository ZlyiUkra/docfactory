{
  "instance": "class-transformer",
  "port": 8875,
  "collection": "docs-class-transformer",
  "embed_model": "bge-small",
  "pause_sec": 1,
  "redact": [
    {
      "pattern": "ﬀ",
      "with": "ff"
    },
    {
      "pattern": "ﬁ",
      "with": "fi"
    },
    {
      "pattern": "ﬂ",
      "with": "fl"
    },
    {
      "pattern": "ﬃ",
      "with": "ffi"
    },
    {
      "pattern": "ﬄ",
      "with": "ffl"
    }
  ],
  "server_name": "class-transformer-docs",
  "doc_set": "class-transformer",
  "sections": "markdown",
  "versions": true,
  "max_per_doc": 0,
  "revision_suffix": true,
  "passage_context": true,
  "tools": {
    "search": "search_docs",
    "read": "read_section"
  },
  "answer_hosts": [
    "github.com",
    "www.npmjs.com"
  ],
  "example_label": "class-transformer"
}
