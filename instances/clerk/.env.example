# Скопіюйте у .env і підставте свій ключ
ANTHROPIC_API_KEY=sk-ant-...

# Необовʼязково
ANTHROPIC_MODEL=claude-sonnet-4-6
MAX_TOKENS=1200
MAX_TURNS=6

# Лише для збирання корпусу: з токеном ліміт GitHub API росте з 60 звернень на годину до 5000.
# Досить найвужчого — fine-grained із Public repositories (read-only) або класичного без scope.
# Читається тільки з цього файла й додається тільки до звернень на api.github.com.
GITHUB_TOKEN=
