    {
      "id": "site",
      "url": "https://developers.cloudflare.com/sitemap-0.xml",
      "reader": "sitemap-accept",
      "within": [
        "https://developers.cloudflare.com/"
      ],
      "drop": [
        "^\\[Skip to content\\]\\(#main-content\\)\\s*$",
        "^> (Documentation Index|Fetch the complete documentation index|Use this file to discover)[^\\n]*$",
        "^[^\\n]*Copy as Markdown\\|[^\\n]*$",
        "^Was this helpful\\?[\\s\\S]*",
        " ?↗︎",
        "^\\[?View RSS feeds[^\\n]*\\n+\\[?Back to all posts[^\\n]*$",
        "^```json\\n\\{\\\"@context\\\":\\\"https://schema\\.org\\\"[^\\n]*\\n```[ \\t]*$"
      ],
      "title": "developers.cloudflare.com: увесь сайт документації",
      "added": "2026-10-31",
      "note": "Every page of developers.cloudflare.com listed in sitemap-0.xml (all products: Workers platform, DNS, WAF, Zero Trust, CDN, changelog posts and the rest; paginated changelog listings are excluded — they repeat the posts), fetched as markdown with `Accept: text/markdown`. The site is not versioned (the cloudflare-docs repository has no tags), so this is a current snapshot. `drop` removes the per-page navigation: skip link, the llms.txt notice, the 'Last updated | Copy as Markdown' line and everything from 'Was this helpful?' on (feedback, 'On this page', JSON-LD). Changelog posts also lose the 'View RSS feeds / Back to all posts' header and the JSON-LD block.",
      "exclude": [
        "^https://developers\\.cloudflare\\.com/changelog/(?!post/)"
      ]
    },
