{
  "instance": "drizzle",
  "port": 8830,
  "collection": "docs-drizzle",
  "embed_model": "bge-small",
  "pause_sec": 0.3,
  "server_name": "drizzle-docs",
  "doc_set": "drizzle",
  "sections": "markdown",
  "versions": true,
  "revision_suffix": true,
  "passage_context": true,
  "slug_rewrite": [
    [
      "^src-content-documentation-docs-",
      "src-content-docs-"
    ],
    [
      "^src-content-documentation-kit-docs-overview$",
      "src-content-docs-kit-overview"
    ],
    [
      "^src-content-documentation-kit-docs-(config-reference|faq|quick|upgrade-21)$",
      "src-content-docs-\\1"
    ],
    [
      "^src-content-documentation-kit-docs-",
      "src-content-docs-kit-"
    ],
    [
      "^src-content-documentation-drizzle-studio-",
      "src-pages-drizzle-studio-"
    ],
    [
      "^src-content-(guides|latest-releases|migrate|tutorials)-",
      "src-content-docs-\\1-"
    ],
    [
      "^src-content-docs-guides-queries-",
      "src-content-docs-guides-"
    ],
    [
      "^src-content-docs-tutorials-drizzle-with-db-drizzle-with-db$",
      "src-content-docs-tutorials-drizzle-with-db-drizzle-with-turso"
    ]
  ],
  "tools": {
    "search": "search_docs",
    "read": "read_section"
  },
  "answer_hosts": [
    "orm.drizzle.team",
    "github.com",
    "www.npmjs.com",
    "registry.npmjs.org"
  ],
  "example_label": "select",
  "version_line_depth": 2
}
