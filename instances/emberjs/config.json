{
  "instance": "emberjs",
  "port": 8940,
  "collection": "docs-emberjs",
  "embed_model": "bge-small",
  "pause_sec": 0.2,
  "server_name": "emberjs-docs",
  "doc_set": "emberjs",
  "sections": "markdown",
  "versions": true,
  "revision_suffix": true,
  "passage_context": true,
  "tools": {
    "search": "search_docs",
    "read": "read_section"
  },
  "answer_hosts": [
    "guides.emberjs.com",
    "api.emberjs.com",
    "deprecations.emberjs.com",
    "cli.emberjs.com",
    "blog.emberjs.com",
    "rfcs.emberjs.com",
    "warp-drive.io",
    "github.com",
    "www.npmjs.com"
  ],
  "example_label": "components",
  "demote": {
    "pattern": "^(?:rfcs-text|blog-content|releases-ember|releases-warp-drive|ember-changelog|warp-drive-changelog)-",
    "places": 10
  }
}
