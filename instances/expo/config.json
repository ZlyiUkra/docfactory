{
  "instance": "expo",
  "port": 8819,
  "collection": "docs-expo",
  "embed_model": "bge-small",
  "pause_sec": 0.5,
  "server_name": "expo-docs",
  "doc_set": "expo",
  "sections": "markdown",
  "versions": true,
  "revision_suffix": true,
  "passage_context": true,
  "slug_rewrite": [
    [
      "-[0-9a-f]{8}-[0-9a-f]{6}$",
      ""
    ]
  ],
  "families": {
    "expo-release": [
      "expo-release-sdk-57",
      "expo-release-sdk-56",
      "expo-release-sdk-55",
      "expo-release-sdk-54",
      "expo-release-sdk-53",
      "expo-release-sdk-52",
      "expo-release-sdk-51",
      "expo-release-sdk-50"
    ]
  },
  "tools": {
    "search": "search_docs",
    "read": "read_section"
  },
  "answer_hosts": [
    "docs.expo.dev",
    "expo.dev",
    "github.com",
    "www.npmjs.com"
  ],
  "example_label": "camera"
}
