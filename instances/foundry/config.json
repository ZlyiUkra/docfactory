{
  "instance": "foundry",
  "port": 8829,
  "collection": "docs-foundry",
  "embed_model": "bge-small",
  "pause_sec": 0.3,
  "server_name": "foundry-docs",
  "doc_set": "foundry",
  "sections": "markdown",
  "versions": true,
  "revision_suffix": true,
  "passage_context": true,
  "max_per_doc": 1,
  "slug_rewrite": [
    [
      "^vocs-docs-pages-",
      "src-pages-"
    ],
    [
      "^src-pages-",
      "src-"
    ],
    [
      "^src-cast-reference-",
      "src-reference-cast-"
    ],
    [
      "^src-forge-reference-",
      "src-reference-forge-"
    ],
    [
      "^src-chisel-reference-",
      "src-reference-chisel-"
    ],
    [
      "^src-anvil-reference-",
      "src-reference-anvil-"
    ],
    [
      "^src-reference-cli-",
      "src-reference-"
    ],
    [
      "^src-reference-(cast|forge|chisel|anvil)-\\1-",
      "src-reference-\\1-"
    ],
    [
      "^src-reference-cast-index$",
      "src-reference-cast-index-cmd"
    ],
    [
      "^src-reference-config-",
      "src-config-reference-"
    ],
    [
      "^src-cheatcodes-readme$",
      "src-reference-cheatcodes-overview"
    ],
    [
      "^src-cheatcodes-",
      "src-reference-cheatcodes-"
    ],
    [
      "^src-reference-forge-std-readme$",
      "src-reference-forge-std-overview"
    ],
    [
      "^src-(anvil|cast|chisel)-overview$",
      "src-\\1-index"
    ],
    [
      "^src-(anvil|cast|chisel|forge)-readme$",
      "src-\\1-index"
    ],
    [
      "^src-reference-(anvil|chisel)-(?:readme|overview)$",
      "src-reference-\\1-\\1"
    ],
    [
      "^src-(?:misc-)?faq$",
      "src-help-faq"
    ],
    [
      "^src-(?:misc|guides)-v1-0-migration$",
      "src-guides-migrations-foundry-v1"
    ],
    [
      "^src-(?:guides|tutorials)-best-practices$",
      "src-best-practices"
    ],
    [
      "^src-projects-project-layout$",
      "src-projects-layout"
    ],
    [
      "^src-forge-(?:tests-)?fork-testing$",
      "src-guides-fork-testing"
    ],
    [
      "^src-forge-advanced-testing-invariant-testing$",
      "src-guides-invariant-testing"
    ]
  ],
  "families": {
    "book": [
      "book-3",
      "book-2",
      "book-1"
    ]
  },
  "tools": {
    "search": "search_docs",
    "read": "read_section"
  },
  "answer_hosts": [
    "getfoundry.sh",
    "www.getfoundry.sh",
    "book.getfoundry.sh",
    "github.com",
    "www.npmjs.com",
    "registry.npmjs.org"
  ],
  "example_label": "expectRevert",
  "version_line_depth": 2
}
