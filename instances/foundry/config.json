{
  "instance": "foundry",
  "port": 8829,
  "collection": "docs-foundry",
  "embed_model": "bge-small",
  "pause_sec": 0.3,
  "server_name": "foundry-docs",
  "doc_set": "foundry",
  "sections": "markdown",
  "versions": true,
  "revision_suffix": true,
  "passage_context": true,
  "slug_rewrite": [
    [
      "^vocs-docs-pages-",
      "src-pages-"
    ],
    [
      "^src-pages-",
      "src-"
    ]
  ],
  "families": {
    "book": [
      "book-3",
      "book-2",
      "book-1"
    ]
  },
  "tools": {
    "search": "search_docs",
    "read": "read_section"
  },
  "answer_hosts": [
    "getfoundry.sh",
    "www.getfoundry.sh",
    "book.getfoundry.sh",
    "github.com",
    "www.npmjs.com",
    "registry.npmjs.org"
  ],
  "example_label": "expectRevert",
  "version_line_depth": 2
}
