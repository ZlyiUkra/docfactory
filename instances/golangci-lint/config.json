{
  "instance": "golangci-lint",
  "port": 8925,
  "collection": "docs-golangci-lint",
  "embed_model": "bge-small",
  "pause_sec": 0.2,
  "server_name": "golangci-lint-docs",
  "doc_set": "golangci-lint",
  "sections": "markdown",
  "versions": true,
  "version_line_depth": 2,
  "revision_suffix": true,
  "passage_context": true,
  "tools": {
    "search": "search_docs",
    "read": "read_section"
  },
  "answer_hosts": [
    "golangci-lint.run",
    "github.com"
  ],
  "example_label": ".golangci.yml"
}
