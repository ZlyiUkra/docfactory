{
  "instance": "i18next",
  "port": 8816,
  "collection": "docs-i18next",
  "embed_model": "bge-small",
  "pause_sec": 1,
  "server_name": "i18next-docs",
  "doc_set": "i18next",
  "sections": "markdown",
  "versions": true,
  "revision_suffix": true,
  "passage_context": true,
  "slug_rewrite": [
    ["^(api|configuration-options|getting-started|plugins-and-utils|supported-frameworks|for-enterprises)$", "overview-\\1"],
    ["^(essentials|interpolation|formatting|plurals|nesting|context|objects-and-arrays)$", "translation-function-\\1"],
    ["^(add-or-load-translations|faq)$", "how-to-\\1"]
  ],
  "tools": {
    "search": "search_docs",
    "read": "read_section"
  },
  "answer_hosts": [
    "www.i18next.com",
    "i18next.github.io",
    "github.com",
    "www.npmjs.com"
  ],
  "example_label": "interpolation"
}
