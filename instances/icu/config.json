{
  "instance": "icu",
  "port": 8840,
  "collection": "docs-icu",
  "embed_model": "bge-small",
  "pause_sec": 0,
  "server_name": "icu-docs",
  "doc_set": "icu",
  "sections": "markdown",
  "versions": true,
  "max_per_doc": 0,
  "revision_suffix": true,
  "passage_context": true,
  "tools": {
    "search": "search_docs",
    "read": "read_section"
  },
  "answer_hosts": [
    "unicode-org.github.io",
    "icu.unicode.org",
    "github.com"
  ],
  "example_label": "ucol_open",
  "slug_rewrite": [
    [
      "^api-(?:icu4c-)?source-(?:common|i18n|io|layoutex)-unicode-",
      "api-"
    ],
    [
      "^int-(?:icu4c-)?source-(?:common|i18n|io)-",
      "int-"
    ]
  ]
}