{
  "instance": "loki",
  "port": 8911,
  "collection": "docs-loki",
  "embed_model": "bge-small",
  "pause_sec": 0.3,
  "server_name": "loki-docs",
  "doc_set": "loki",
  "sections": "markdown",
  "versions": true,
  "revision_suffix": true,
