{
 "instance": "mupdf",
 "port": 8998,
 "collection": "docs-mupdf",
 "embed_model": "bge-small",
 "pause_sec": 0.2,
 "server_name": "mupdf-docs",
 "doc_set": "mupdf",
 "sections": "markdown",
 "versions": true,
 "revision_suffix": true,
 "version_line_depth": 2,
 "passage_context": true,
 "tools": {
  "search": "search_docs",
  "read": "read_section"
 },
 "answer_hosts": [
  "mupdf.readthedocs.io",
  "pymupdf.readthedocs.io",
  "ghostscript.com",
  "github.com",
  "pypi.org"
 ],
 "example_label": "fz_open_document",
 "slug_rewrite": [
  [
   "^(pymupdf-docs-.+)-txt$",
   "\\1-rst"
  ],
  [
   "^mupdf-docs-src-(mutool-[a-z-]+|mupdf-gl)-rst$",
   "mupdf-docs-tools-\\1-rst"
  ],
  [
   "^mupdf-docs-manual-(mutool-[a-z-]+|mupdf-gl)-html$",
   "mupdf-docs-tools-\\1-rst"
  ],
  [
   "^mupdf-docs-(?:coding-overview-html|overview-txt|src-using-mupdf-rst)$",
   "mupdf-docs-reference-c-overview"
  ]
 ],
 "families": {
  "mupdf-docs": [
   "mupdf-docs",
   "mupdf-docs-src",
   "mupdf-html",
   "mupdf-txt"
  ],
  "pymupdf-docs": [
   "pymupdf-docs",
   "pymupdf-docs-119"
  ]
 }
}