{
  "instance": "nats",
  "port": 8894,
  "collection": "docs-nats",
  "embed_model": "bge-small",
  "pause_sec": 0.3,
  "server_name": "nats-docs",
  "doc_set": "nats",
  "sections": "markdown",
  "versions": true,
  "revision_suffix": true,
  "passage_context": true,
  "tools": {
    "search": "search_docs",
    "read": "read_section"
  },
  "answer_hosts": [
    "docs.nats.io",
    "github.com"
  ],
  "example_label": "nats",
  "families": {
    "nats-ref": [
      "nats-ref-2.15",
      "nats-ref-2.14",
      "nats-ref-2.12",
      "nats-ref-2.11"
    ]
  },
  "slug_rewrite": [
    [
      "^nats-reference-versioned-docs-version-\\d+-\\d+-(.+?)(?:-index)?$",
      "nats-reference-\\1"
    ],
    [
      "^nats-(learn|docs|tutorials)-(.+?)-index$",
      "nats-\\1-\\2"
    ]
  ]
}