{
  "instance": "next-themes",
  "port": 8835,
  "collection": "docs-next-themes",
  "embed_model": "bge-small",
  "pause_sec": 1,
  "server_name": "next-themes-docs",
  "doc_set": "next-themes",
  "sections": "markdown",
  "versions": true,
  "version_line_depth": 2,
  "max_per_doc": 0,
  "revision_suffix": true,
