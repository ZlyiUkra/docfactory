      "next-themes-examples-examples-example-pages-"
    ]
  ],
  "tools": {
    "search": "search_docs",
    "read": "read_section"
  },
  "answer_hosts": [
    "github.com",
    "www.npmjs.com"
  ],
  "example_label": "next-themes"
}
