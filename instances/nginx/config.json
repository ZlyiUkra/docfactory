{
  "instance": "nginx",
  "port": 8798,
  "collection": "docs-nginx",
  "embed_model": "bge-small",
  "pause_sec": 1,
  "server_name": "nginx-docs",
  "doc_set": "nginx",
  "sections": "markdown",
  "versions": true,
  "version_line_depth": 2,
  "slug_rewrite": [["^xml-en-docs-(.+)-xml$", "nginx-\\1"], ["^content-nic-lts-", "nic-"],
                   ["^content-nginx-index$", "nginx-plus-index"], ["^content-", ""],
                   ["^ingress-nginx-docs-", "ingress-nginx-"], ["^(\\d+\\.\\d+\\.\\d+)$", "changes-\\1"]],
  "revision_suffix": true,
  "passage_context": true,
  "tools": {"search": "search_docs", "read": "read_section"},
  "answer_hosts": ["nginx.org", "docs.nginx.com", "github.com"],
  "example_label": "proxy_pass",
  "families": {
    "nic": ["nic", "nic-lts"]
  }
}
