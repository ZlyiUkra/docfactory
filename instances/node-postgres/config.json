{
  "instance": "node-postgres",
  "port": 8805,
  "collection": "docs-node-postgres",
  "embed_model": "bge-small",
  "pause_sec": 1,
  "server_name": "node-postgres-docs",
  "doc_set": "node-postgres",
  "sections": "markdown",
  "versions": true,
  "max_per_doc": 0,
  "revision_suffix": true,
  "passage_context": true,
  "tools": {
    "search": "search_docs",
    "read": "read_section"
  },
  "answer_hosts": [
    "node-postgres.com",
    "github.com",
    "www.npmjs.com"
  ],
  "example_label": "Client",
  "slug_rewrite": [
    [
      "^content-api-\\d-(\\w+)$",
      "docs-pages-apis-\\1"
    ],
    [
      "^content-features-\\d-(\\w+)$",
      "docs-pages-features-\\1"
    ],
    [
      "^content-guides-\\d-(.+)$",
      "docs-pages-guides-\\1"
    ],
    [
      "^content-announcements$",
      "docs-pages-announcements"
    ],
    [
      "^content-welcome$",
      "docs-pages-index"
    ]
  ]
}
