{
  "instance": "ollama",
  "port": 8854,
  "collection": "docs-ollama",
  "embed_model": "bge-small",
  "pause_sec": 0,
  "server_name": "ollama-docs",
  "doc_set": "ollama",
  "sections": "markdown",
  "versions": true,
  "version_line_depth": 2,
  "revision_suffix": true,
  "passage_context": true,
  "tools": {
    "search": "search_docs",
    "read": "read_section"
  },
  "answer_hosts": [
    "docs.ollama.com",
    "ollama.com",
    "github.com",
    "www.npmjs.com",
    "registry.npmjs.org",
    "pypi.org"
  ],
  "example_label": "Modelfile",
  "slug_rewrite": [
    [
      "^docs-",
      ""
    ]
  ],
  "families": {
    "docs": [
      "site",
      "docs"
    ]
  },
  "fusion_depth": 10
}
