{
  "instance": "openssl",
  "port": 8839,
  "collection": "docs-openssl",
  "embed_model": "bge-small",
  "pause_sec": 0,
  "server_name": "openssl-docs",
  "doc_set": "openssl",
  "sections": "markdown",
  "versions": true,
  "max_per_doc": 0,
  "revision_suffix": true,
  "passage_context": true,
  "tools": {
    "search": "search_docs",
    "read": "read_section"
  },
  "answer_hosts": [
    "docs.openssl.org",
    "www.openssl.org",
    "github.com"
  ],
  "example_label": "openssl req",
  "slug_rewrite": [
    [
      "^doc-apps-",
      "doc-man1-"
    ],
    [
      "^doc-(?:crypto|ssl)-",
      "doc-man3-"
    ],
    [
      "-pod(?:-in)?$",
      ""
    ],
    [
      "^doc-man1-(?!openssl|c-rehash|tsget)",
      "doc-man1-openssl-"
    ]
  ]
}