{
  "instance": "orval",
  "port": 8883,
  "collection": "docs-orval",
  "embed_model": "bge-small",
  "pause_sec": 1,
  "server_name": "orval-docs",
  "doc_set": "orval",
  "sections": "markdown",
  "versions": true,
  "max_per_doc": 0,
  "revision_suffix": true,
  "passage_context": true,
  "tools": {
    "search": "search_docs",
    "read": "read_section"
  },
  "answer_hosts": [
    "orval.dev",
    "github.com",
    "www.npmjs.com"
  ],
  "example_label": "orval",
  "slug_rewrite": [
    [
      "^orval-docs-(?:src-pages|content-docs)-(.+)$",
      "orval-\\1"
    ]
  ]
}
