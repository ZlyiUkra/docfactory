{
 "instance": "pandoc",
 "port": 9000,
 "collection": "docs-pandoc",
 "embed_model": "bge-small",
 "pause_sec": 0.2,
 "server_name": "pandoc-docs",
 "doc_set": "pandoc",
 "sections": "markdown",
 "versions": true,
 "revision_suffix": true,
 "version_line_depth": 2,
 "passage_context": true,
 "tools": {
  "search": "search_docs",
  "read": "read_section"
 },
 "answer_hosts": [
  "pandoc.org",
  "lierdakil.github.io",
  "scorreia.com",
  "github.com",
  "www.npmjs.com",
  "pypi.org",
  "hub.docker.com"
 ],
 "example_label": "toc-depth",
 "slug_rewrite": [
  [
   "^pandoc-readme$",
   "pandoc-manual-txt"
  ],
  [
   "^(readme|core|extra|latex|minimal|typst|previous-versions|sections-.+)$",
   "pandoc-docker-\\1"
  ]
 ],
 "families": {
  "pandoc-manual": [
   "pandoc-manual",
   "pandoc-manual-readme"
  ]
 }
}