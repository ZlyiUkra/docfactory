{
  "instance": "paperjs",
  "port": 8993,
  "collection": "docs-paperjs",
  "embed_model": "bge-small",
  "pause_sec": 0.2,
  "server_name": "paperjs-docs",
  "doc_set": "paperjs",
  "sections": "markdown",
  "versions": true,
  "revision_suffix": true,
  "passage_context": true,
  "tools": {
    "search": "search_docs",
    "read": "read_section"
  },
  "answer_hosts": [
    "paperjs.org",
    "unpkg.com",
    "github.com",
    "www.npmjs.com"
  ],
  "example_label": "Path",
  "slug_rewrite": [
    [
      "^site-content-07-tutorials-\\d+-.+?-\\d+-(.+)-tutorial-txt",
      "tutorial-\\1"
    ],
    [
      "^site-content-04-examples-\\d+-(.+)-example-txt",
      "site-example-\\1"
    ],
    [
      "^site-content-01-about-faq-tutorial-txt",
      "site-faq"
    ],
    [
      "^site-content-01-about-roadmap-page-txt",
      "site-roadmap"
    ],
    [
      "^site-content-01-about-page-txt",
      "site-about"
    ],
    [
      "^site-content-02-features-page-txt",
      "site-features"
    ],
    [
      "^example-examples-",
      "repo-example-"
    ]
  ]
}
