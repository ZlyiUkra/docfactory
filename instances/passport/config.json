{
  "instance": "passport",
  "port": 8871,
  "collection": "docs-passport",
  "embed_model": "bge-small",
  "pause_sec": 1,
  "server_name": "passport-docs",
  "doc_set": "passport",
  "sections": "markdown",
  "versions": true,
  "version_line_depth": 2,
  "max_per_doc": 0,
  "revision_suffix": true,
  "passage_context": true,
  "tools": {
    "search": "search_docs",
    "read": "read_section"
  },
  "answer_hosts": [
    "github.com",
    "www.npmjs.com",
    "www.passportjs.org"
  ],
  "example_label": "passport",
  "slug_rewrite": [
    [
      "^passport-readme$",
      "passport-markdown"
    ],
    [
      "^passport-local-readme$",
      "passport-local-markdown"
    ],
    [
      "^passport-facebook-readme$",
      "passport-facebook-markdown"
    ],
    [
      "^passport-http-bearer-readme$",
      "passport-http-bearer-markdown"
    ]
  ]
}
