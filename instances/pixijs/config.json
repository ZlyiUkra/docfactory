  "versions": true,
  "revision_suffix": true,
  "passage_context": true,
  "tools": {
    "search": "search_docs",
    "read": "read_section"
  },
  "answer_hosts": [
    "pixijs.com",
    "pixijs.download",
    "3d.pixijs.download",
    "react.pixijs.io",
    "pixijs.io",
    "github.com",
    "www.npmjs.com"
  ],
  "example_label": "Sprite",
  "slug_rewrite": [
    [
      "^v\\d+-\\d+-\\d+-docs-pixi-",
      "api-pixi-"
    ]
  ],
  "families": {
    "api-old": [
      "api-7",
      "api-6",
      "api-5",
      "api-4"
    ]
  }
}
