{
  "instance": "pyarrow",
  "port": 8986,
  "collection": "docs-pyarrow",
  "embed_model": "bge-small",
  "pause_sec": 0.5,
  "server_name": "pyarrow-docs",
  "doc_set": "pyarrow",
  "sections": "markdown",
  "versions": true,
  "version_line_depth": 2,
  "revision_suffix": true,
  "passage_context": true,
  "title_match": true,
  "slug_rewrite": [
    [
      "^parquet-parquet$",
      "parquet"
    ],
    [
      "^parquet-parquet-(.+)$",
      "parquet-\\1"
    ]
  ],
  "tools": {
    "search": "search_docs",
    "read": "read_section"
  },
  "answer_hosts": [
    "arrow.apache.org",
    "github.com",
    "pypi.org"
  ],
  "example_label": "parquet"
}
