{
  "instance": "pytest",
  "port": 8985,
  "collection": "docs-pytest",
  "embed_model": "bge-small",
  "pause_sec": 1.0,
  "server_name": "pytest-docs",
  "doc_set": "pytest",
  "sections": "markdown",
  "versions": true,
  "version_line_depth": 2,
  "revision_suffix": true,
  "passage_context": true,
  "title_match": true,
  "slug_rewrite": [
    [
      "^pytest-doc-en-",
      ""
    ],
    [
      "^reference$",
      "reference-reference"
    ],
    [
      "^fixture$",
      "how-to-fixtures"
    ],
    [
      "^skipping$",
      "how-to-skipping"
    ],
    [
      "^parametrize$",
      "how-to-parametrize"
    ],
    [
      "^monkeypatch$",
      "how-to-monkeypatch"
    ],
    [
      "^tmpdir$",
      "how-to-tmp-path"
    ],
    [
      "^capture$",
      "how-to-capture-stdout-stderr"
    ],
    [
      "^logging$",
      "how-to-logging"
    ],
    [
      "^assert$",
      "how-to-assert"
    ],
    [
      "^mark$",
      "how-to-mark"
    ],
    [
      "^cache$",
      "how-to-cache"
    ],
    [
      "^usage$",
      "how-to-usage"
    ],
    [
      "^warnings$",
      "how-to-capture-warnings"
    ],
    [
      "^customize$",
      "reference-customize"
    ],
    [
      "^flaky$",
      "explanation-flaky"
    ],
    [
      "^goodpractices$",
      "explanation-goodpractices"
    ],
    [
      "^plugins$",
      "how-to-plugins"
    ],
    [
      "^writing-plugins$",
      "how-to-writing-plugins"
    ],
    [
      "^unittest$",
      "how-to-unittest"
    ],
    [
      "^xunit-setup$",
      "how-to-xunit-setup"
    ],
    [
      "^doctest$",
      "how-to-doctest"
    ],
    [
      "^nose$",
      "how-to-nose"
    ],
    [
      "^existingtestsuite$",
      "how-to-existingtestsuite"
    ],
    [
      "^bash-completion$",
      "how-to-bash-completion"
    ],
    [
      "^pythonpath$",
      "explanation-pythonpath"
    ],
    [
      "^writing-hook-functions$",
      "how-to-writing-hook-functions"
    ]
  ],
  "families": {
    "pytest": [
      "pytest-site",
      "pytest-repo"
    ]
  },
  "tools": {
    "search": "search_docs",
    "read": "read_section"
  },
  "answer_hosts": [
    "docs.pytest.org",
    "github.com",
    "pypi.org"
  ],
  "example_label": "fixture"
}
