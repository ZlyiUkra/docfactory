{
  "instance": "python",
  "port": 8944,
  "collection": "docs-python",
  "embed_model": "bge-small",
  "pause_sec": 0.2,
  "server_name": "python-docs",
  "doc_set": "python",
  "sections": "markdown",
  "versions": true,
  "version_line_depth": 2,
  "revision_suffix": true,
  "passage_context": true,
  "tools": {
    "search": "search_docs",
    "read": "read_section"
  },
  "answer_hosts": [
    "docs.python.org",
    "peps.python.org",
    "packaging.python.org",
    "pip.pypa.io",
    "docs.astral.sh",
    "python-poetry.org",
    "docs.pypi.org",
    "pypi.org",
    "github.com"
  ],
  "example_label": "json",
  "families": {
    "site-old": [
      "site-2.5",
      "site-2.4",
      "site-2.3",
      "site-2.2",
      "site-2.1",
      "site-2.0",
      "site-1.6",
      "site-1.5",
      "site-1.4"
    ]
  },
  "slug_rewrite": [
    [
      "^pip-docs-(?:html-)?(?:reference|cli)-",
      "pip-docs-html-cli-"
    ],
    [
      "^poetry-docs-docs-",
      "poetry-docs-"
    ]
  ]
}