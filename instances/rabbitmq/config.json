{
  "instance": "rabbitmq",
  "port": 8890,
  "collection": "docs-rabbitmq",
  "embed_model": "bge-small",
  "pause_sec": 0.3,
  "server_name": "rabbitmq-docs",
  "doc_set": "rabbitmq",
  "sections": "markdown",
  "versions": true,
  "revision_suffix": true,
  "passage_context": true,
  "tools": {
    "search": "search_docs",
    "read": "read_section"
  },
  "answer_hosts": [
    "www.rabbitmq.com",
    "github.com"
  ],
  "example_label": "rabbitmq",
  "families": {
    "rmq-site": [
      "rmq-4.4",
      "rmq-4.3",
      "rmq-4.2",
      "rmq-4.1",
      "rmq-4.0",
      "rmq-3.13",
      "rmq-3.12",
      "rmq-3.11"
    ]
  },
  "slug_rewrite": [
    [
      "^rabbitmq-versioned-docs-version-\\d+-\\d+-(.+?)(?:-index)?$",
      "rabbitmq-\\1"
    ],
    [
      "^rabbitmq-site-(.+)$",
      "rabbitmq-\\1"
    ],
    [
      "^rabbitmq-(blog|tutorials|client-libraries|kubernetes|release-information)-(.+?)-index$",
      "rabbitmq-\\1-\\2"
    ]
  ]
}
