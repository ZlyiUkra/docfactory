  "answer_hosts": [
    "docs.scipy.org",
    "github.com",
    "pypi.org"
  ],
  "example_label": "minimize",
  "slug_rewrite": [
    [
      "^reference-generated-(.+)$",
      "generated-\\1"
    ]
  ]
}