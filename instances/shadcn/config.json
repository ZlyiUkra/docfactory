{
  "instance": "shadcn",
  "port": 8799,
  "collection": "docs-shadcn",
  "embed_model": "bge-small",
  "pause_sec": 1,
  "server_name": "shadcn-docs",
  "doc_set": "shadcn",
  "sections": "markdown",
  "versions": true,
  "slug_rewrite": [["^(?!(?:apps|deprecated|data|docs-src|packages)-)(?:[a-z0-9-]+-)?(use[a-z0-9]+)$",
                    "react-aria-\\1"],
                   ["^(?!(?:apps|deprecated|data|docs-src|packages|react-aria)-)(.+)$", "rac-\\1"],
                   ["^apps-v4-content-docs-components-radix-", "shadcn-components-"],
                   ["^apps-v4-content-docs-root-", "shadcn-"],
                   ["^apps-v4-content-docs-", "shadcn-"],
                   ["^(?:apps|deprecated)-www-content-docs-", "shadcn-tw3-"],
                   ["^data-primitives-docs-(?:components|utilities)-([a-z-]+?)-\\d+-\\d+-\\d+$", "radix-\\1"],
                   ["^data-primitives-docs-(?:components|utilities)-", "radix-"],
                   ["^data-primitives-docs-", "radix-"],
                   ["^data-themes-docs-", "radix-themes-"],
                   ["^data-colors-(?:docs-)?getting-started-", "radix-colors-overview-"],
                   ["^data-colors-palette-composition-the-scales$",
                    "radix-colors-palette-composition-scales"],
                   ["^data-colors-(?:docs-)?", "radix-colors-"],
                   ["^docs-src-app-docs-(?:content-)?react-page$", "base-ui-index"],
                   ["^docs-src-app-docs-(?:content-)?react-(.+)-page$", "base-ui-\\1"],
                   ["^packages-react-aria-components-docs-(.+)$", "rac-\\1"],
                   ["^packages-react-aria-[a-z0-9-]+?-docs-(.+)$", "react-aria-\\1"],
                   ["^packages-dev-docs-pages-react-aria-(.+)$", "react-aria-\\1"]],
  "families": {
    "react-aria": ["react-aria-site", "react-aria-components", "react-aria-hooks"]
  },
  "revision_suffix": true,
  "passage_context": true,
  "tools": {"search": "search_docs", "read": "read_section"},
  "answer_hosts": ["github.com", "ui.shadcn.com", "www.radix-ui.com", "base-ui.com", "react-aria.adobe.com"],
  "example_label": "Trigger"
}
