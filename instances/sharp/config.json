{
 "instance": "sharp",
 "port": 8999,
 "collection": "docs-sharp",
 "embed_model": "bge-small",
 "pause_sec": 0.2,
 "server_name": "sharp-docs",
 "doc_set": "sharp",
 "sections": "markdown",
 "versions": true,
 "revision_suffix": true,
 "version_line_depth": 2,
 "passage_context": true,
 "tools": {
  "search": "search_docs",
  "read": "read_section"
 },
 "answer_hosts": [
  "sharp.pixelplumbing.com",
  "www.libvips.org",
  "libvips.github.io",
  "github.com",
  "www.npmjs.com",
  "pypi.org"
 ],
 "example_label": "resize",
 "slug_rewrite": [
  [
   "^sharp-docs-src-content-docs-(.+)$",
   "sharp-docs-\\1"
  ],
  [
   "^sharp-docs-readme$",
   "sharp-docs-index"
  ],
  [
   "^using-command-line$",
   "libvips-doc-using-the-cli"
  ],
  [
   "^using-c$",
   "libvips-doc-using-from-c"
  ],
  [
   "^(?:using-cpp|libvips-doc-libvips-from-c)$",
   "libvips-doc-using-from-cplusplus"
  ],
  [
   "^(using-threads|extending|file-format|function-list|using-python)$",
   "libvips-doc-\\1"
  ]
 ],
 "families": {
  "sharp-docs": [
   "sharp-docs",
   "sharp-docs-old"
  ],
  "libvips-guide": [
   "libvips-guide",
   "libvips-guide-md",
   "libvips-guide-docbook"
  ]
 }
}