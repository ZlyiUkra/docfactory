{
  "instance": "snapsvg",
  "port": 8994,
  "collection": "docs-snapsvg",
  "embed_model": "bge-small",
  "pause_sec": 0.2,
  "server_name": "snapsvg-docs",
  "doc_set": "snapsvg",
  "sections": "markdown",
  "versions": true,
  "revision_suffix": true,
  "passage_context": true,
  "tools": {
    "search": "search_docs",
    "read": "read_section"
  },
  "answer_hosts": [
    "snapsvg.io",
    "github.com",
    "www.npmjs.com"
  ],
  "example_label": "Paper",
  "slug_rewrite": [
    [
      "^api-(?:doc|dist)-reference-html",
      "api-reference"
    ],
    [
      "^demo-demos-",
      "demo-"
    ],
    [
      "^site-source-index-html",
      "site-home"
    ],
    [
      "^site-source-page-(.+)-html",
      "site-\\1"
    ]
  ]
}
