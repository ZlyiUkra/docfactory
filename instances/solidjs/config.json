{
  "instance": "solidjs",
  "port": 8928,
  "collection": "docs-solidjs",
  "embed_model": "bge-small",
  "pause_sec": 0.1,
  "server_name": "solidjs-docs",
  "doc_set": "solidjs",
  "sections": "markdown",
  "versions": true,
  "revision_suffix": true,
  "passage_context": true,
  "tools": {
    "search": "search_docs",
    "read": "read_section"
  },
  "answer_hosts": [
    "docs.solidjs.com",
    "www.solidjs.com",
    "solidjs.com",
    "primitives.solidjs.community",
    "github.com",
    "www.npmjs.com"
  ],
  "example_label": "signals",
  "redact": [
    {
      "pattern": "(?m)^# версія: 2\\.0\\.0-rc\\.19\\n\\n",
      "with": "# версія: 2.0.0-rc.19\n\n> **Solid 2.0 release candidate (2.0.0-rc.19), not a stable release.** Реліз-кандидат 2.0, не стабільна.\n\n"
    }
  ],
  "slug_rewrite": [
    [
      "(?<=[a-z])-\\d{1,2}(?=-[a-z])",
      ""
    ],
    [
      "^src-routes-reference-solid-router-",
      "src-routes-solid-router-reference-"
    ],
    [
      "^src-routes-solid-start-v[12]-",
      "src-routes-solid-start-"
    ],
    [
      "^src-routes-solid-meta-v1-",
      "src-routes-solid-meta-"
    ]
  ]
}