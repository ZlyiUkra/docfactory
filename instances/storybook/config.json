{
  "instance": "storybook",
  "port": 8821,
  "collection": "docs-storybook",
  "embed_model": "bge-small",
  "pause_sec": 0.3,
  "server_name": "storybook-docs",
  "doc_set": "storybook",
  "sections": "markdown",
  "versions": true,
  "revision_suffix": true,
  "passage_context": true,
  "slug_rewrite": [
    [
      "^api-frameworks-feature-support$",
      "configure-integration-frameworks-feature-support"
    ],
    [
      "^configure-integration-styling-and-css$",
      "configure-styling-and-css"
    ],
    [
      "^api-main-config$",
      "api-main-config-main-config"
    ],
    [
      "^migration-guide$",
      "releases-migration-guide"
    ],
    [
      "^migration-guide-from-older-version$",
      "releases-migration-guide-from-older-version"
    ],
    [
      "^writing-docs-doc-blocks-(doc-block-[a-z]+)$",
      "api-doc-blocks-\\1"
    ],
    [
      "^writing-tests-import-stories-in-tests-(stories-in-(?:end-to-end|unit)-tests)$",
      "writing-tests-integrations-\\1"
    ],
    [
      "^writing-tests-snapshot-testing-snapshot-testing$",
      "writing-tests-snapshot-testing"
    ],
    [
      "^writing-tests-test-runner$",
      "writing-tests-integrations-test-runner"
    ],
    [
      "^writing-tests-test-addon$",
      "writing-tests-integrations-vitest-addon"
    ]
  ],
  "tools": {
    "search": "search_docs",
    "read": "read_section"
  },
  "answer_hosts": [
    "storybook.js.org",
    "github.com",
    "www.npmjs.com"
  ],
  "example_label": "decorators"
}
