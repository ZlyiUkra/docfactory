{
  "instance": "svelte",
  "port": 8931,
  "collection": "docs-svelte",
  "embed_model": "bge-small",
  "pause_sec": 0.1,
  "server_name": "svelte-docs",
  "doc_set": "svelte",
  "sections": "markdown",
  "versions": true,
  "revision_suffix": true,
  "passage_context": true,
  "tools": {
    "search": "search_docs",
    "read": "read_section"
  },
  "answer_hosts": [
    "svelte.dev",
    "v2.svelte.dev",
    "github.com",
    "www.npmjs.com"
  ],
  "example_label": "$state",
  "families": {
    "svelte-site": [
      "docs",
      "docs-v2"
    ]
  },
  "slug_rewrite": [
    [
      "^site-content-",
      "documentation-"
    ]
  ]
}
