{
  "instance": "sveltekit",
  "port": 8932,
  "collection": "docs-sveltekit",
  "embed_model": "bge-small",
  "pause_sec": 0.1,
  "server_name": "sveltekit-docs",
  "doc_set": "sveltekit",
  "sections": "markdown",
  "versions": true,
  "revision_suffix": true,
  "passage_context": true,
  "tools": {
    "search": "search_docs",
    "read": "read_section"
  },
  "answer_hosts": [
    "svelte.dev",
    "sapper.svelte.dev",
    "github.com",
    "www.npmjs.com"
  ],
  "example_label": "load",
  "slug_rewrite": [
    [
      "^apps-svelte-dev-content-docs-kit-",
      "documentation-docs-"
    ],
    [
      "(?<=[a-z])-\\d{1,2}(?=-[a-z])",
      ""
    ]
  ],
  "families": {
    "kit-docs": [
      "docs",
      "reference-generated"
    ]
  }
}
