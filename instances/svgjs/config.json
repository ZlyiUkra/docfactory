{
  "instance": "svgjs",
  "port": 8992,
  "collection": "docs-svgjs",
  "embed_model": "bge-small",
  "pause_sec": 0.2,
  "server_name": "svgjs-docs",
  "doc_set": "svgjs",
  "sections": "markdown",
  "versions": true,
  "revision_suffix": true,
  "passage_context": true,
  "tools": {
    "search": "search_docs",
    "read": "read_section"
  },
  "answer_hosts": [
    "svgjs.dev",
    "github.com",
    "www.npmjs.com"
  ],
  "example_label": "SVG",
  "slug_rewrite": [
    [
      "^site-content-1-home-default-txt",
      "site-home"
    ],
    [
      "^site-content-\\d+-(.+?)-\\d+-(.+?)-default-txt",
      "site-\\1-\\2"
    ],
    [
      "^site-content-\\d+-(.+?)-default-txt",
      "site-\\1"
    ]
  ]
}
