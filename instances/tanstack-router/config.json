{
  "instance": "tanstack-router",
  "port": 8822,
  "collection": "docs-tanstack-router",
  "embed_model": "bge-small",
  "pause_sec": 1,
  "server_name": "tanstack-router-docs",
  "doc_set": "tanstack-router",
  "sections": "markdown",
  "versions": true,
  "revision_suffix": true,
  "passage_context": true,
  "tools": {
    "search": "search_docs",
    "read": "read_section"
  },
  "answer_hosts": [
    "tanstack.com",
    "github.com",
    "www.npmjs.com"
  ],
  "example_label": "createRouter",
  "slug_rewrite": [
    [
      "^docs-framework-react-start-",
      "docs-start-framework-react-"
    ],
    [
      "^docs-start-framework-(react|solid)-(?!guide-|tutorial-|how-to-|(?:overview|getting-started|build-from-scratch|comparison|start-vs-nextjs|migrate-from-next-js|quick-start|learn-the-basics)$)",
      "docs-start-framework-\\1-guide-"
    ],
    [
      "^docs-framework-react-",
      "docs-router-"
    ],
    [
      "^docs-router-framework-react-",
      "docs-router-"
    ],
    [
      "^docs-(guide|api)-",
      "docs-router-\\1-"
    ],
    [
      "^docs-(comparison|devtools|overview|quick-start|eslint-)",
      "docs-router-\\1"
    ],
    [
      "^docs-(?:router-)?migrate-from-react-(router|location)$",
      "docs-router-installation-migrate-from-react-\\1"
    ]
  ]
}
