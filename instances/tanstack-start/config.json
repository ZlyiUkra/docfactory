{
  "instance": "tanstack-start",
  "port": 8941,
  "collection": "docs-tanstack-start",
  "embed_model": "bge-small",
  "pause_sec": 0.5,
  "server_name": "tanstack-start-docs",
  "doc_set": "tanstack-start",
  "sections": "markdown",
  "versions": true,
  "revision_suffix": true,
  "passage_context": true,
  "tools": {
    "search": "search_docs",
    "read": "read_section"
  },
  "answer_hosts": [
    "tanstack.com",
    "github.com",
    "www.npmjs.com"
  ],
  "example_label": "createServerFn",
  "slug_rewrite": [
    [
      "^start-latest-docs-framework-",
      "docs-start-framework-"
    ],
    [
      "^docs-framework-react-start-",
      "docs-start-framework-react-"
    ],
    [
      "^docs-start-framework-(react|solid|vue)-(?!guide-|tutorial-|how-to-|(?:overview|getting-started|build-from-scratch|comparison|start-vs-nextjs|migrate-from-next-js|migrate-from-release-candidate|quick-start|learn-the-basics)$)",
      "docs-start-framework-\\1-guide-"
    ]
  ],
  "families": {
    "start-pages": [
      "start-site",
      "start-docs"
    ]
  },
  "variant_pattern": "^(?:docs-start-framework|examples)-(react|solid|vue)-",
  "variant_strict": true,
  "variant_aliases": {
    "react": [
      "react"
    ],
    "solid": [
      "solid",
      "solidjs",
      "solid js"
    ],
    "vue": [
      "vue",
      "vuejs",
      "vue js"
    ]
  }
}
