{
  "instance": "tanstack-virtual",
  "port": 8803,
  "collection": "docs-tanstack-virtual",
  "embed_model": "bge-small",
  "pause_sec": 1,
  "server_name": "tanstack-virtual-docs",
  "doc_set": "tanstack-virtual",
  "sections": "markdown",
  "versions": true,
  "max_per_doc": 2,
  "revision_suffix": true,
  "passage_context": true,
  "tools": {
    "search": "search_docs",
    "read": "read_section"
  },
  "answer_hosts": [
    "tanstack.com",
    "github.com",
    "www.npmjs.com"
  ],
  "example_label": "Virtualizer",
  "families": {
    "tv-examples": [
      "tv-examples-v3",
      "tv-examples-v2",
      "tv-examples-v1"
    ]
  },
  "slug_rewrite": [
    [
      "^docs-adapters-(\\w+)-virtual$",
      "docs-framework-\\1-\\1-virtual"
    ],
    [
      "^docs-guide-(?:\\d\\d-)?",
      "docs-"
    ],
    [
      "^docs-src-pages-docs-",
      "docs-"
    ]
  ]
}
