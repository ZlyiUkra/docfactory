{
  "instance": "threejs",
  "port": 8935,
  "collection": "docs-threejs",
  "embed_model": "bge-small",
  "pause_sec": 0.1,
  "server_name": "threejs-docs",
  "doc_set": "threejs",
  "sections": "markdown",
  "versions": true,
  "revision_suffix": true,
  "passage_context": true,
  "tools": {
    "search": "search_docs",
    "read": "read_section"
  },
  "answer_hosts": [
    "threejs.org",
    "github.com",
    "www.npmjs.com"
  ],
  "example_label": "PerspectiveCamera",
  "slug_rewrite": [
    [
      "-html$",
      ""
    ],
    [
      "^docs-api-(?:en-)?(?:[a-z0-9]+-)*(?=[a-z0-9]+$)",
      "docs-pages-"
    ],
    [
      "^docs-examples-(?:en-)?(?:[a-z0-9]+-)*(?=[a-z0-9]+$)",
      "docs-pages-"
    ],
    [
      "^docs-manual-(?:en-)?[a-z0-9]+-",
      "manual-pages-"
    ],
    [
      "^manual-en-",
      "manual-pages-"
    ]
  ]
}
