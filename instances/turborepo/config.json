{
  "instance": "turborepo",
  "port": 8906,
  "collection": "docs-turborepo",
  "embed_model": "bge-small",
  "pause_sec": 0.3,
  "server_name": "turborepo-docs",
  "doc_set": "turborepo",
  "sections": "markdown",
  "versions": true,
  "revision_suffix": true,
  "passage_context": true,
  "tools": {
    "search": "search_docs",
    "read": "read_section"
  },
  "answer_hosts": [
    "turborepo.dev",
    "turborepo.com",
    "turbo.build",
    "github.com",
    "www.npmjs.com"
  ],
  "example_label": "turborepo",
  "slug_rewrite": [
    [
      "^turbo-(?:apps-docs-content-docs|docs-site-content-docs|docs-repo-docs|docs-pages-repo-docs|docs-pages-docs)-(.+)$",
      "turbo-docs-\\1"
    ],
    [
      "^turbo-(?:apps-docs-content-blog|docs-site-content-blog|docs-pages-blog)-(.+)$",
      "turbo-blog-\\1"
    ]
  ]
}