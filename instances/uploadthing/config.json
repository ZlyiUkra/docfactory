{
  "instance": "uploadthing",
  "port": 8900,
  "collection": "docs-uploadthing",
  "embed_model": "bge-small",
  "pause_sec": 0.3,
  "server_name": "uploadthing-docs",
  "doc_set": "uploadthing",
  "sections": "markdown",
  "versions": true,
  "revision_suffix": true,
  "passage_context": true,
  "tools": {
    "search": "search_docs",
    "read": "read_section"
  },
  "answer_hosts": [
    "docs.uploadthing.com",
    "v6.docs.uploadthing.com",
    "uploadthing.com",
    "github.com",
    "www.npmjs.com"
  ],
  "example_label": "uploadthing",
  "slug_rewrite": [
    [
      "^uploadthing-docs-src-app-docs-page$",
      "uploadthing-index"
    ],
    [
      "^uploadthing-docs-src-app-docs-(.+?)-page$",
      "uploadthing-\\1"
    ],
    [
      "^uploadthing-docs-src-app-blog-posts-(.+?)-page$",
      "uploadthing-blog-\\1"
    ],
    [
      "^uploadthing-docs-src-pages-(.+)$",
      "uploadthing-\\1"
    ],
    [
      "^uploadthing-(auth-security|theming)$",
      "uploadthing-concepts-\\1"
    ],
    [
      "^uploadthing-regions-and-acl$",
      "uploadthing-concepts-regions-acl"
    ],
    [
      "^uploadthing-errors$",
      "uploadthing-concepts-error-handling"
    ],
    [
      "^uploadthing-nextjs-(appdir|pagedir)$",
      "uploadthing-getting-started-\\1"
    ],
    [
      "^uploadthing-solid$",
      "uploadthing-getting-started-solid"
    ]
  ],
  "title_match": true
}
