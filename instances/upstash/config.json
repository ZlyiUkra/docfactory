{
  "instance": "upstash",
  "port": 8849,
  "collection": "docs-upstash",
  "embed_model": "bge-small",
  "pause_sec": 0,
  "server_name": "upstash-docs",
  "doc_set": "upstash",
  "sections": "markdown",
  "versions": true,
  "max_per_doc": 0,
  "revision_suffix": true,
  "passage_context": true,
  "tools": {
    "search": "search_docs",
    "read": "read_section"
  },
  "answer_hosts": [
    "upstash.com",
    "github.com",
    "registry.npmjs.org",
    "www.npmjs.com",
    "pypi.org"
  ],
  "example_label": "Pipeline",
  "slug_rewrite": [
    [
      "^blog-data-blog-",
      "blog-"
    ],
    [
      "^blog-data-glossary-",
      "glossary-"
    ],
    [
      "^site-kafka-",
      "docs-kafka-"
    ],
    [
      "^skills-skills-",
      "skills-"
    ],
    [
      "^([a-z0-9-]+)-test-test-",
      "\\1-test-"
    ],
    [
      "^([a-z0-9-]+)-test-tests-",
      "\\1-test-"
    ]
  ]
}
