{
  "instance": "vueuse",
  "port": 8930,
  "collection": "docs-vueuse",
  "embed_model": "bge-small",
  "pause_sec": 0.1,
  "server_name": "vueuse-docs",
  "doc_set": "vueuse",
  "sections": "markdown",
  "versions": true,
  "revision_suffix": true,
  "passage_context": true,
  "tools": {
    "search": "search_docs",
    "read": "read_section"
  },
  "answer_hosts": [
    "vueuse.org",
    "motion.vueuse.org",
    "gesture.vueuse.org",
    "github.com",
    "www.npmjs.com"
  ],
  "example_label": "useStorage",
  "families": {
    "vueuse-docs": [
      "docs",
      "docs-2020"
    ]
  },
  "slug_rewrite": [
    [
      "^motion-docs-content-\\d+-api-\\d+-",
      "motion-docs-api-"
    ],
    [
      "^motion-docs-content-\\d+-(?:getting-started|features)-\\d+-",
      "motion-docs-"
    ],
    [
      "^motion-docs-content-index$",
      "motion-docs-index"
    ]
  ]
}
